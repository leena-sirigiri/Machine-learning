        "#STEP 4 COMAPRING TWO SENTENCES\n",
        "import numpy as np\n",
        "\n",
        "def cosine_similarity(sentence1, sentence2):\n",
        "    tokens1 = sentence1.lower().split()\n",
        "    tokens2 = sentence2.lower().split()\n",
        "\n",
        "    vocabulary = np.unique(tokens1 + tokens2)\n",
        "\n",
        "    vector1 = np.array([tokens1.count(word) for word in vocabulary])\n",
        "    vector2 = np.array([tokens2.count(word) for word in vocabulary])\n",
        "\n",
        "    return np.dot(vector1, vector2) / (\n",
        "        np.linalg.norm(vector1) * np.linalg.norm(vector2)\n",
        "    )\n",
        "\n",
        "# Similar pair\n",
        "sentence1 = \"I love learning Python programming\"\n",
        "sentence2 = \"Python programming is very useful\"\n",
        "\n",
        "# Very different pair\n",
        "sentence3 = \"I love learning Python programming\"\n",
        "sentence4 = \"The ocean has beautiful blue waves\"\n",
        "\n",
        "similarity1 = cosine_similarity(sentence1, sentence2)\n",
        "similarity2 = cosine_similarity(sentence3, sentence4)\n",
        "\n",
        "print(\"Similar pair similarity:\", similarity1)\n",
        "print(\"Different pair similarity:\", similarity2)\n",
        "\n"
